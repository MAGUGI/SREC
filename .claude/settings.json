{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./server/**)",
      "Read(./client/**)",
      "Read(./docs/**)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run migrate:*)",
      "Bash(npx jest:*)",
      "Bash(node --version)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Read(./server/.env)",
      "Read(./client/.env)",
      "Read(./client/.env.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "includeCoAuthoredBy": false
}
