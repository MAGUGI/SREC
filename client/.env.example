# Base URL of the SREC API, including the /api prefix.
# Only VITE_-prefixed variables reach the client code (Vite 8), and they are
# replaced at BUILD time: restart `npm run dev` or rebuild after changing them.
# Copy this file to .env and adjust it to your environment:
#   cp .env.example .env
#
# Local development (default when the variable is missing):
VITE_API_BASE_URL=http://localhost:5000/api
#
# docker compose passes the same value as a build arg (see docker-compose.yml).

# Timeout of each request, in milliseconds.
VITE_API_TIMEOUT_MS=10000
